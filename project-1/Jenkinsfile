pipeline {
  agent any
 
  environment {
    PROJECT_DIR = "project-1"
    PM2_APP_NAME = "node-app"
    EMAIL_TO = "prabhakaran63806@gmail.com"
  }
 
  stages {
    stage('Preparation') {
      steps {
        // Changed to use clear Jenkins string injection to avoid /bin/sh Bad Substitution error
        echo "Build started!"
        echo "Build Number: ${env.BUILD_NUMBER}"
        sh 'ls -la'
      }
    }
 
    stage('Install Dependencies') {
      steps {
        dir("${PROJECT_DIR}") {
          sh 'npm install'
        }
      }
    }
 
    stage('Run Tests') {
      steps {
        dir("${PROJECT_DIR}") {
          sh 'npm test || echo "Tests skipped or mock completed"'
        }
      }
    }
 
    stage('Deploy with PM2') {
      when {
        expression { currentBuild.currentResult == 'SUCCESS' }
      }
      steps {
        dir("${PROJECT_DIR}") {
          sh '''
            export PATH=$PATH:/usr/local/bin
            echo "Deploying app using PM2..."
 
            if pm2 list | grep -q "${PM2_APP_NAME}"; then
              echo "App exists -> Restarting..."
              pm2 restart "${PM2_APP_NAME}"
            else
              echo "App not found -> Starting..."
              pm2 start server.js --name "${PM2_APP_NAME}"
            fi
 
            pm2 save
          '''
        }
      }
    }
  }
 
  post {
    always {
      script {
        def buildStatus = currentBuild.currentResult ?: 'UNKNOWN'
        mail(
          to: "${EMAIL_TO}",
          subject: "Jenkins Build ${buildStatus}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
          body: """Build Notification
 
Job: ${env.JOB_NAME}
Build: #${env.BUILD_NUMBER}
Status: ${buildStatus}
URL: ${env.BUILD_URL}"""
        )
      }
    }
  }
}
